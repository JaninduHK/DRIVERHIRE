# Config for scripts/backup.sh — copy to "backup.env" (gitignored) next to this
# file and fill in real values. Never commit the real backup.env.
#   cp scripts/backup.env.example scripts/backup.env

# Second server you control, reachable over SSH, where backups are shipped.
# Must NOT be the same VPS that hosts the app — the point is surviving a
# disk failure or compromise of this box.
REMOTE_HOST=backup.example.com
REMOTE_USER=backup
REMOTE_PATH=/home/backup/driverhire

# SSH key with access to REMOTE_HOST (passwordless, dedicated to this job).
SSH_KEY=/root/.ssh/driverhire_backup_ed25519

# Docker Compose project name — determines the volume prefix
# (<COMPOSE_PROJECT>_uploads_data). Matches the app directory name unless
# COMPOSE_PROJECT_NAME was overridden when the stack was brought up.
COMPOSE_PROJECT=driverhire

# How many days of backups to keep on the remote.
RETENTION_DAYS=14

# Optional: path to a file containing a passphrase (chmod 600, root-only) used
# to GPG-encrypt a snapshot of backend/.env and .env before shipping it off-box.
# Leave unset/blank to skip backing up secrets entirely.
# Generate one with: openssl rand -base64 32 > /root/.driverhire-backup-passphrase
#                     chmod 600 /root/.driverhire-backup-passphrase
SECRETS_PASSPHRASE_FILE=/root/.driverhire-backup-passphrase

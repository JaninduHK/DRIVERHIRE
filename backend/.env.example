# MongoDB Connection URI
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# For Local MongoDB: mongodb://localhost:27017/driverhire
MONGO_URI=mongodb://localhost:27017/driverhire

# JWT Configuration
JWT_EXPIRES_IN=1h
JWT_SECRET=your-secret-key-here-change-in-production

# Server Configuration
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Admin Setup
ADMIN_SETUP_CODE=change_me

# Email Configuration
EMAIL_FROM=hello@carwithdriver.lk
BREVO_API_KEY=your-brevo-api-key

# Asset Upload URLs
# For production, use your domain: https://yourdomain.com/uploads
# For local development: http://localhost:3000/uploads
PUBLIC_ASSET_BASE_URL=http://localhost:3000/uploads

# Asgardeo SSO (traveller sign-in) — see ASGARDEO_SETUP.md at the repo root
# for how to create the tenant/app and get these values.
# ASGARDEO_ISSUER_URL is just https://api.asgardeo.io/t/<your-org-name> —
# the redirect URI must be OUR backend's callback route (not the frontend
# origin), matching whatever's registered in the Asgardeo app.
ASGARDEO_ISSUER_URL=https://api.asgardeo.io/t/your-org-name
ASGARDEO_CLIENT_ID=your-asgardeo-client-id
ASGARDEO_CLIENT_SECRET=your-asgardeo-client-secret
ASGARDEO_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback
ASGARDEO_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/traveller/sign-in

# Google/Facebook sign-in for travellers is configured as federated identity
# providers inside the Asgardeo console (reuse the same OAuth app
# credentials there) rather than read from this app's environment.

# Cloudinary Configuration (for cloud-based image storage)
# Sign up at https://cloudinary.com and get your credentials from the dashboard
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER_PREFIX=driverhire

# Dependencies
node_modules/

# Build outputs
frontend/dist/

# Environment files — never commit real secrets (backend/.env, frontend/.env, mobile/.env, etc.)
.env
.env.*
# ...but keep example/template files tracked
!.env.example
!.env.*.example

# Docker / Let's Encrypt runtime data
certbot/
backups/

# Logs
logs/
*.log
npm-debug.log*

# User uploads (preserved on server, never committed)
uploads/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Temporary files
*.tmp
*.temp
mobile/*.apk
mobile/*.aab
